# Discord Developer Portal の Bot ページで発行したトークン（公開しないこと）
DISCORD_TOKEN=

# ボットを使うサーバーの ID
GUILD_ID=

# 勤務として数えるボイスチャンネルの ID（複数ならカンマ区切り）
WORK_VOICE_CHANNEL_IDS=

# 打刻を流すテキストチャンネルの ID（省略すると流さない）
LOG_CHANNEL_ID=

# VC から切断しても勤務が続く扱いにする時間（分）
GRACE_MINUTES=5

# この時間を過ぎても戻らない休憩・散歩は、抜けた時点で退勤にする（分）
MAX_AWAY_MINUTES=180

# 記録を保存する SQLite ファイル
DB_PATH=data/timecard.db

# 日付の区切りと表示に使うタイムゾーン
TZ=Asia/Tokyo
